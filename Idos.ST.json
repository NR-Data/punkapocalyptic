        "rules": [
          {
            "name": "Especialistas",
            "id": "e3d8-5a8c-5e32-cebd",
            "description": "Los cosechadores no son demasiado comunes. Sólo podrá haber un cosechador por cada fracción de 200 puntos de la banda.",
            "hidden": false
          },
          {
            "name": "Mal viaje Cosechador",
            "id": "2447-de86-6068-1c80",
            "description": "El Cosechador tiene la mente demasiado dispersa y no podrá cosechar.",
            "hidden": false
          },
          {
            "name": "Cosecha",
            "id": "2620-ff40-0a8c-87fa",
            "description": "un cosechador puede gastar 1 Acción en cosechar a un enemigo Abatido (ningún Abatido puede ser cosechado más de una vez), extrayendo el líquido de su hipotálamo. La cantidad de Ambrosía cosechada dependerá del grado de terror de la víctima. Deberás tirar en la siguiente tabla para comprobar cuantas dosis de Ambrosía ha cosechado para la banda, que podrá utilizar de manera habitual:\n\n1: Ninguna\n2-5: 1\n6-9: 2\n10: 3",
            "hidden": false
          }
        ],
