        "rules": [
          {
            "name": "Furia psicótica",
            "id": "8552-07dd-e937-65cf",
            "description": "Los  desgarradores  sólo  piensan  en  ir  a  rajar  a  sus  enemigos.  Avanzarán  hacia  el  enemigo al que lleguen más rápidamente (independientemente de la Línea de visión). Normalmente esto es el más cercano, pero habrá casos donde puede tener un enemigo cerca encima de un edificio, o tras terreno Pila chungo, y sin embargo puede cubrir más terreno avanzando hacia otro enemigo.",
            "hidden": false
          },
          {
            "name": "Mal viaje Desgarrador",
            "id": "3480-d1ba-74c9-a2b8",
            "description": "En  caso  de  tener  en  distancia  de  Asalto  a  alguna  miniatura,  el  desgarrador  la  Asaltará  independientemente de que sea amiga o enemiga.",
            "hidden": false
          }
        ],
